import java.util.Scanner;

public class NQueen {

    static int N;
    static int[] board;
    static int solutionCount = 0;

    // Check whether placing a queen at (row, col) is safe
    static boolean isSafe(int row, int col) {
        for (int i = 1; i <= row - 1; i++) {
            // Same column
            if (board[i] == col) {
                return false;
            }
            // Same diagonal
            if (Math.abs(board[i] - col) == Math.abs(i - row)) {
                return false;
            }
        }
        return true;
    }

    // Print the board for one solution
    static void printBoard() {
        solutionCount++;
        System.out.println("\nSolution " + solutionCount + ":");
        for (int i = 1; i <= N; i++) {
            for (int j = 1; j <= N; j++) {
                if (board[i] == j) {
                    System.out.print("Q ");
                } else {
                    System.out.print(". ");
                }
            }
            System.out.println();
        }
    }

    static void nQueen(int row) {
        if (row > N) {
            printBoard();
            return;
        }

        for (int col = 1; col <= N; col++) {
            if (isSafe(row, col)) {
                board[row] = col;      // place queen
                nQueen(row + 1);       // go to next row
                board[row] = 0;        // backtrack
            }
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter the number of queens (N): ");
        N = sc.nextInt();

        board = new int[N + 1];   // index 0 unused

        nQueen(1);

        if (solutionCount == 0) {
            System.out.println("No solution exists for N = " + N);
        } else {
            System.out.println("\nTotal solutions: " + solutionCount);
        }
        sc.close();
    }
}
