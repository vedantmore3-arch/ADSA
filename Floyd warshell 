#include <bits/stdc++.h>
using namespace std;
const int INF = 1e9;

int main() {
    int n = 4;
    vector<vector<int>> d = {
        {0,   3,   INF, 7},
        {8,   0,   2,   INF},
        {5,   INF, 0,   1},
        {2,   INF, INF, 0}
    };

    for (int k = 0; k < n; k++)
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                if (d[i][k] != INF && d[k][j] != INF)
                    d[i][j] = min(d[i][j], d[i][k] + d[k][j]);

    // negative cycle check
    for (int i = 0; i < n; i++)
        if (d[i][i] < 0) {
            cout << "Negative cycle exists\n";
            return 0;
        }

    for (auto &row : d) {
        for (int x : row) {
            if (x == INF) cout << "INF ";
            else cout << x << " ";
        }
        cout << "\n";
    }
}