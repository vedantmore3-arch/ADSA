import java.util.*;

public class HashTable {
    private int size;
    private LinkedList<Integer>[] table;

    @SuppressWarnings("unchecked")
    HashTable(int size) {
        this.size = size;
        table = new LinkedList[size];
        for (int i = 0; i < size; i++) table[i] = new LinkedList<>();
    }

    int hashIndex(int key) { return key % size; }

    void insert(int key) { table[hashIndex(key)].add(key); }

    boolean search(int key) { return table[hashIndex(key)].contains(key); }

    void remove(int key) { table[hashIndex(key)].remove(Integer.valueOf(key)); }

    void display() {
        for (int i = 0; i < size; i++) {
            System.out.print(i + ": ");
            for (int x : table[i]) System.out.print(x + " -> ");
            System.out.println("NULL");
        }
    }

    public static void main(String[] args) {
        HashTable h = new HashTable(7);
        for (int k : new int[]{50, 700, 76, 85, 92, 73, 101}) h.insert(k);
        h.display();
        System.out.println(h.search(85) + " " + h.search(99)); // true false
    }
}